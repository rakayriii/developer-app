GITHUB_CLIENT_ID=your_github_oauth_client_id
GITHUB_CLIENT_SECRET=your_github_oauth_client_secret
APP_URL=http://localhost:3000
SESSION_SECRET=replace_with_a_long_random_secret
DOCKER_SOCKET_PATH=/var/run/docker.sock
DATABASE_URL=postgresql://developer_os:change_me@localhost:5432/developer_os
GIT_WORKSPACE_ROOT=/home/skywalker
TERMINAL_MAX_SESSIONS_PER_USER=4
TERMINAL_MAX_SESSIONS_TOTAL=20
TERMINAL_IDLE_TIMEOUT_MS=1800000
TERMINAL_WORKING_DIRECTORY=
DEPLOYMENT_DEFAULT_CPU_LIMIT=1.0
DEPLOYMENT_DEFAULT_MEMORY_LIMIT=512m
DEPLOYMENT_HEALTH_TIMEOUT_MS=5000
DEPLOYMENT_MAX_LOG_BYTES=262144
DEPLOYMENT_DOCKER_TIMEOUT_MS=600000
