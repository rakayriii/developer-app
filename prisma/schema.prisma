generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ProjectStatus {
  active
  paused
  archived
}

enum DeploymentEnvironmentType {
  development
  staging
  production
}

enum DeploymentStatus {
  pending
  building
  starting
  running
  unhealthy
  failed
  stopping
  stopped
  rolled_back
}

enum ServerAuthMethod {
  key
}

enum ServerStatus {
  unknown
  online
  offline
  error
}

model User {
  id          String    @id @default(cuid())
  githubLogin String    @unique
  projects    Project[]
  servers     Server[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Server {
  id                    String           @id @default(cuid())
  userId                String
  user                  User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  name                  String
  hostname              String
  port                  Int              @default(22)
  username              String
  authMethod            ServerAuthMethod @default(key)
  encryptedCredential   String?
  credentialFingerprint String?
  credentialConfigured  Boolean          @default(false)
  hostKeyFingerprint    String?
  hostKeyLine           String?
  hostKeyTrustedAt      DateTime?
  status                ServerStatus     @default(unknown)
  statusCode            String?
  statusMessage         String?
  osName                String?
  osVersion             String?
  architecture          String?
  kernel                String?
  dockerVersion         String?
  dockerAvailable       Boolean          @default(false)
  cpuCount              Int?
  memoryBytes           BigInt?
  diskBytes             BigInt?
  diskFreeBytes         BigInt?
  lastCheckedAt         DateTime?
  lastConnectedAt       DateTime?
  lastError             String?
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt
  checks                ServerCheck[]

  @@unique([userId, hostname, port])
  @@index([userId])
  @@index([status])
}

model ServerCheck {
  id                  String       @id @default(cuid())
  serverId            String
  server              Server       @relation(fields: [serverId], references: [id], onDelete: Cascade)
  status              ServerStatus
  code                String?
  message             String?
  hostKeyFingerprint  String?
  hostKeyTrusted      Boolean      @default(false)
  durationMs          Int?
  createdAt           DateTime     @default(now())

  @@index([serverId, createdAt])
}

model Project {
  id                 String                   @id @default(cuid())
  userId             String
  user               User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name               String
  slug               String
  description        String?
  status             ProjectStatus            @default(active)
  githubOwner        String?
  githubRepo         String?
  localRepositoryPath String?
  dockerAssociations ProjectDockerContainer[]
  environments       DeploymentEnvironment[]
  deployments         Deployment[]
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt

  @@unique([userId, slug])
  @@index([userId, status])
}

model DeploymentEnvironment {
  id                 String                    @id @default(cuid())
  projectId          String
  project            Project                   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name               String
  slug               String
  type               DeploymentEnvironmentType
  containerPort      Int                       @default(3000)
  hostPort           Int
  healthPath         String                    @default("/")
  healthTimeoutMs    Int                       @default(5000)
  healthRetries      Int                       @default(5)
  cpuLimit           String                    @default("1.0")
  memoryLimit        String                    @default("512m")
  restartPolicy      String                    @default("unless-stopped")
  runMigrations      Boolean                   @default(false)
  createdAt          DateTime                  @default(now())
  updatedAt          DateTime                  @updatedAt
  deployments        Deployment[]
  runtimeVariables   DeploymentEnvironmentVariable[]

  @@unique([projectId, slug])
  @@unique([hostPort])
  @@index([projectId, type])
}

model DeploymentEnvironmentVariable {
  id            String               @id @default(cuid())
  environmentId String
  environment   DeploymentEnvironment @relation(fields: [environmentId], references: [id], onDelete: Cascade)
  name          String
  secret        Boolean              @default(false)
  value         String?
  secretValue   String?
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  @@unique([environmentId, name])
}

model Deployment {
  id            String              @id @default(cuid())
  projectId     String
  project       Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  environmentId String
  environment   DeploymentEnvironment @relation(fields: [environmentId], references: [id], onDelete: Cascade)
  commitSha     String
  branch        String?
  imageTag      String
  dockerfile    String?
  containerId   String?
  containerName String?
  status          DeploymentStatus    @default(pending)
  healthStatus    String?
  errorMessage    String?
  lastStage       String?
  stopReason      String?
  rollbackOfId    String?
  rolledBackFromId String?
  startedAt       DateTime?
  finishedAt      DateTime?
  restartedAt     DateTime?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  logs            DeploymentLog[]

  @@index([projectId, createdAt])
  @@index([environmentId, status])
  @@index([containerId])
  @@index([rollbackOfId])
}

model DeploymentLog {
  id           String     @id @default(cuid())
  deploymentId String
  deployment   Deployment @relation(fields: [deploymentId], references: [id], onDelete: Cascade)
  timestamp    DateTime   @default(now())
  stream       String
  message      String

  @@index([deploymentId, timestamp])
}

model ProjectDockerContainer {
  id          String   @id @default(cuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  containerId String
  createdAt   DateTime @default(now())

  @@unique([projectId, containerId])
  @@index([projectId])
}
